<%= form_with model: [:gm, quest], class: "space-y-6" do |form| %>
  <% if quest.errors.any? %>
    <div class="p-4 rounded border border-red-500/30 bg-red-950/40 text-red-200">
      <p class="font-bold mb-2"><%= pluralize(quest.errors.count, "erreur") %> empêchent l'enregistrement :</p>
      <ul class="list-disc pl-5 space-y-1 text-sm">
        <% quest.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4">
    <div>
      <%= form.label :title, "Titre", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= form.text_field :title, class: "w-full rounded bg-gray-900 border border-white/10 px-4 py-3 text-white" %>
    </div>

    <div>
      <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-300 mb-2" %>
      <%= form.text_area :description, rows: 6, class: "w-full rounded bg-gray-900 border border-white/10 px-4 py-3 text-white" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :reward_xp, "XP de récompense", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= form.number_field :reward_xp, min: 0, class: "w-full rounded bg-gray-900 border border-white/10 px-4 py-3 text-white" %>
      </div>

      <div class="flex items-center gap-3 rounded bg-gray-900 border border-white/10 px-4 py-3 mt-7 md:mt-0">
        <%= form.check_box :published, class: "h-4 w-4 rounded border-white/20 bg-gray-800 text-indigo-500" %>
        <%= form.label :published, "Publié", class: "text-sm font-medium text-gray-300" %>
      </div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= form.submit class: "px-4 py-2 bg-indigo-600 text-white rounded" %>
    <%= link_to "Retour", gm_quests_path, class: "px-4 py-2 border border-white/10 text-gray-200 rounded" %>
  </div>
<% end %>