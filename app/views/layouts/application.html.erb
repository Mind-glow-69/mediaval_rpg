<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mediaval Rpg" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if Rails.env.development? %>
      <div class="p-3 bg-gray-900 text-white text-sm flex gap-4 border-b border-white/10">
        <%= link_to 'Mockups', dev_mockups_path, class: 'hover:underline' %>
        <%= link_to 'GM Dashboard', gm_dashboard_path, class: 'hover:underline' %>
        <%= link_to 'GM Quests', gm_quests_path, class: 'hover:underline' %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
